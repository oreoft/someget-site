---
// 落地页统一骨架：顶部大图 → 它能做什么 → 点一点试试（手机演示）→ 下载。
// 每个产品只提供 content/<id>.js 里的文案和 demos/ 里的一个演示组件，版块顺序和样式在这里统一。
import BaseLayout from './BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import PhoneFrame from './PhoneFrame.astro';
import MacFrame from './MacFrame.astro';
import DownloadCta from './DownloadCta.astro';
import LoopbackDemo from '../demos/LoopbackDemo.astro';
import MuninnDemo from '../demos/MuninnDemo.astro';
import InStashDemo from '../demos/InStashDemo.astro';
import BlinkDemo from '../demos/BlinkDemo.astro';
import RaijuDemo from '../demos/RaijuDemo.astro';
import FastZZDemo from '../demos/FastZZDemo.astro';
import HerdsmanDemo from '../demos/HerdsmanDemo.astro';
import { getProduct } from '../products.js';
import { ui } from '../i18n.js';
import loopback from '../content/loopback.js';
import muninn from '../content/muninn.js';
import instash from '../content/instash.js';
import blink from '../content/blink.js';
import raiju from '../content/raiju.js';
import fastzz from '../content/fastzz.js';
import herdsman from '../content/herdsman.js';

interface Props {
  id: string;
  lang: 'zh' | 'en';
}

const contents: Record<string, any> = { loopback, muninn, instash, blink, raiju, fastzz, herdsman };
const demos: Record<string, any> = { loopback: LoopbackDemo, muninn: MuninnDemo, instash: InStashDemo, blink: BlinkDemo, raiju: RaijuDemo, fastzz: FastZZDemo, herdsman: HerdsmanDemo };
const { id, lang } = Astro.props;
const product = getProduct(id);
const c = contents[id][lang];
const t = ui[lang];
const Demo = demos[id];
// 只有 Mac 版的产品，演示放进 Mac 外框；其余放手机外框；ownFrame 的演示自带外框（电脑 + 手机同框）
const Frame = product.platforms.every((x: string) => x === 'macOS') ? MacFrame : PhoneFrame;
const path = `/${id}`;
const icon = `/icons/${id}.png`;
const iconDark = product.darkIcon ? `/icons/${id}-dark.png` : null;
const storeLabel = product.platforms.includes('macOS') ? t.downloadMac : t.download;
---

<BaseLayout
  lang={lang}
  title={`${product.name} · ${product[lang].tagline}`}
  description={product[lang].summary}
  icon={icon}
  path={path}
  movedTo={product.website ? { zh: `${product.url}/`, en: `${product.url}/en` } : undefined}
>
  <SiteHeader lang={lang} path={path} productPath={path} />
  <main>
    <section class="container hero">
      <div class="hero-text">
        <div class="ident">
          <picture>{iconDark && <source srcset={iconDark} media="(prefers-color-scheme: dark)" />}<img class="app-icon" src={icon} alt="" width="64" height="64" /></picture>
          <div>
            <p class="name display">{product.name}</p>
            <p class="mono platforms">{product.platforms.join(' · ')}</p>
          </div>
        </div>
        <h1 class="display">{c.heroTitle}</h1>
        <p class="sub">{c.heroSub}</p>
        <DownloadCta product={product} t={t} lang={lang} storeLabel={storeLabel} showDemo />
      </div>
      <div class="hero-art" style={`--tint: ${product.tint}`} aria-hidden="true">
        <picture>{iconDark && <source srcset={iconDark} media="(prefers-color-scheme: dark)" />}<img class="app-icon big" src={icon} alt="" width="260" height="260" /></picture>
      </div>
    </section>

    <section class="container block">
      <h2 class="display">{t.sectionIntro}</h2>
      <div class="features">
        {
          c.features.map((f: { title: string; desc: string }, i: number) => (
            <article class="feature">
              <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    {
      (c.video || c.shots) && (
        <section class="container block media">
          <h2 class="display">{c.mediaTitle}</h2>
          {c.mediaDesc && <p class="sub">{c.mediaDesc}</p>}
          {c.video && <video class="promo" src={c.video.src} poster={c.video.poster} controls playsinline preload="none" />}
          {c.shots && (
            <div class:list={['shots', { wide: c.shotsWide }]}>
              {c.shots.map((src: string) => <img src={src} alt="" loading="lazy" width={c.shotsWide ? 2400 : 660} height={c.shotsWide ? 1350 : 1434} />)}
            </div>
          )}
        </section>
      )
    }

    <section id="demo" class:list={["container block demo", { wide: product.ownFrame }]}>
      <div class="demo-text">
        <h2 class="display">{c.demoTitle}</h2>
        <p class="sub">{c.demoDesc}</p>
        <ol class="steps">
          {c.demoSteps.map((s: string) => <li>{s}</li>)}
        </ol>
        <p class="hint">{t.demoHint}</p>
      </div>
      {product.ownFrame ? <Demo lang={lang} /> : (
        <Frame label={`${product.name} demo`}>
          <Demo lang={lang} />
        </Frame>
      )}
    </section>

    <section class="container block download">
      <picture>{iconDark && <source srcset={iconDark} media="(prefers-color-scheme: dark)" />}<img class="app-icon" src={icon} alt="" width="96" height="96" /></picture>
      <div>
        <h2 class="display">{product.name}</h2>
        <p class="sub">{product[lang].tagline}</p>
      </div>
      <div class="download-actions">
        <DownloadCta product={product} t={t} lang={lang} storeLabel={storeLabel} />
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} productPath={path} productName={product.name} />
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding-top: 72px;
    padding-bottom: 72px;
  }
  .ident {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }
  .ident img {
    width: 64px;
    height: 64px;
  }
  .name {
    margin: 0;
    font-size: 24px;
  }
  .platforms {
    margin: 4px 0 0;
    font-size: 12px;
    color: var(--ink-3);
  }
  h1 {
    margin: 0;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 1;
    white-space: pre-line;
  }
  .sub {
    margin: 24px 0 0;
    max-width: 560px;
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink-2);
  }
  .hero-art {
    aspect-ratio: 1;
    border-radius: 40px;
    background: var(--tint);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .big {
    width: 56%;
    height: auto;
    transform: rotate(-6deg);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.28);
  }
  .block {
    padding-top: 72px;
    padding-bottom: 72px;
    border-top: 1px solid var(--line);
  }
  .block > h2,
  .demo-text h2 {
    margin: 0;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.05;
  }
  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 40px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .feature {
    background: var(--bg);
    padding: 28px;
  }
  .num {
    font-size: 13px;
    color: var(--accent);
  }
  .feature h3 {
    margin: 12px 0 10px;
    font-size: 20px;
  }
  .feature p {
    margin: 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--ink-2);
  }
  /* 真机图和宣传视频：视频整宽，截图横向滑动 */
  .promo {
    display: block;
    width: 100%;
    margin-top: 40px;
    border-radius: 20px;
    background: #000;
    aspect-ratio: 16 / 9;
  }
  .shots {
    display: flex;
    gap: 20px;
    margin-top: 28px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
  }
  .shots img {
    flex: 0 0 auto;
    width: 260px;
    height: auto;
    border-radius: 24px;
    scroll-snap-align: start;
  }
  /* 横版宣传图：两列网格，窄屏单列 */
  .shots.wide {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: visible;
  }
  .shots.wide img {
    width: 100%;
    border-radius: 16px;
  }
  @media (max-width: 760px) {
    .shots.wide {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 64px;
    align-items: center;
  }
  /* 演示自带外框（电脑 + 手机真机画面）：文字在上、演示占满整行，步骤横排 */
  .demo.wide {
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  .demo.wide .steps {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 12px 32px;
  }
  .steps {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: s;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .steps li {
    counter-increment: s;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 17px;
    font-weight: 600;
  }
  .steps li::before {
    content: counter(s);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
    flex-shrink: 0;
  }
  .hint {
    margin: 28px 0 0;
    font-size: 13px;
    color: var(--ink-3);
  }
  .download {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 32px;
  }
  .download img {
    width: 96px;
    height: 96px;
  }
  .download > div {
    flex: 1 1 280px;
  }
  .download h2 {
    margin: 0;
    font-size: 40px;
  }
  .download .sub {
    margin-top: 6px;
  }
  @media (max-width: 960px) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .hero,
    .demo {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-art {
      max-width: 360px;
    }
    .demo {
      justify-items: center;
    }
    .features {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

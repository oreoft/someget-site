---
// 落地页统一骨架：顶部大图 → 它能做什么 → 点一点试试（手机演示）→ 下载。
// 每个产品只提供 content/<id>.js 里的文案和 demos/ 里的一个演示组件，版块顺序和样式在这里统一。
import BaseLayout from './BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import PhoneFrame from './PhoneFrame.astro';
import LoopbackDemo from '../demos/LoopbackDemo.astro';
import MuninnDemo from '../demos/MuninnDemo.astro';
import InStashDemo from '../demos/InStashDemo.astro';
import { getProduct } from '../products.js';
import { ui } from '../i18n.js';
import loopback from '../content/loopback.js';
import muninn from '../content/muninn.js';
import instash from '../content/instash.js';

interface Props {
  id: string;
  lang: 'zh' | 'en';
}

const contents: Record<string, any> = { loopback, muninn, instash };
const demos: Record<string, any> = { loopback: LoopbackDemo, muninn: MuninnDemo, instash: InStashDemo };
const { id, lang } = Astro.props;
const product = getProduct(id);
const c = contents[id][lang];
const t = ui[lang];
const Demo = demos[id];
const path = `/${id}`;
const icon = `/icons/${id}.png`;
const storeLabel = product.platforms.includes('macOS') ? t.downloadMac : t.download;
// 下载按钮里的平台标志（Simple Icons 的 Apple / Android 图形），颜色跟随按钮文字
const appleIcon =
  'M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701';
const androidIcon =
  'M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0117-.7438-1.7997-1.8435-3.0118-2.7402-3.7754-.4342-.3698-.837-.6346-1.1504-.8366.0004-.0004.0011-.0018.0015-.0021.4946-.8605 1.2004-2.0689 2.0274-3.5002.3315-.574.0939-1.2181-.3866-1.5019a1.0767 1.0767 0 0 0-.9707-.0606c-.1916.0819-.3606.2251-.4968.4402zM7.0452 15.0156c-.6036 0-1.0938-.4892-1.0938-1.0938 0-.6046.4902-1.0937 1.0938-1.0937.6046 0 1.0937.4892 1.0937 1.0937 0 .6046-.489 1.0938-1.0937 1.0938zm9.9082 0c-.6046 0-1.0937-.4892-1.0937-1.0938 0-.6046.489-1.0937 1.0937-1.0937.6036 0 1.0938.4892 1.0938 1.0937 0 .6046-.4902 1.0938-1.0938 1.0938z';
---

<BaseLayout lang={lang} title={`${product.name} · ${product[lang].tagline}`} description={product[lang].summary} icon={icon} path={path}>
  <SiteHeader lang={lang} path={path} productPath={path} />
  <main>
    <section class="container hero">
      <div class="hero-text">
        <div class="ident">
          <img class="app-icon" src={icon} alt="" width="64" height="64" />
          <div>
            <p class="name display">{product.name}</p>
            <p class="mono platforms">{product.platforms.join(' · ')}</p>
          </div>
        </div>
        <h1 class="display">{c.heroTitle}</h1>
        <p class="sub">{c.heroSub}</p>
        <div class="actions">
          <a class="pill pill--accent dl" href={product.storeUrl}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={appleIcon} /></svg>{storeLabel}</a>
          {product.androidUrl && <a class="pill pill--accent dl" href={product.androidUrl}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={androidIcon} /></svg>{t.downloadAndroid}</a>}
          <a class="pill" href="#demo">{t.sectionDemo} ↓</a>
        </div>
      </div>
      <div class="hero-art" style={`--tint: ${product.tint}`} aria-hidden="true">
        <img class="app-icon big" src={icon} alt="" width="260" height="260" />
      </div>
    </section>

    <section class="container block">
      <h2 class="display">{t.sectionIntro}</h2>
      <div class="features">
        {
          c.features.map((f: { title: string; desc: string }, i: number) => (
            <article class="feature">
              <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="demo" class="container block demo">
      <div class="demo-text">
        <h2 class="display">{c.demoTitle}</h2>
        <p class="sub">{c.demoDesc}</p>
        <ol class="steps">
          {c.demoSteps.map((s: string) => <li>{s}</li>)}
        </ol>
        <p class="hint">{t.demoHint}</p>
      </div>
      <PhoneFrame label={`${product.name} demo`}>
        <Demo lang={lang} />
      </PhoneFrame>
    </section>

    <section class="container block download">
      <img class="app-icon" src={icon} alt="" width="96" height="96" />
      <div>
        <h2 class="display">{product.name}</h2>
        <p class="sub">{product[lang].tagline}</p>
      </div>
      <div class="download-actions">
        <a class="pill pill--accent dl" href={product.storeUrl}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={appleIcon} /></svg>{storeLabel}</a>
        {product.androidUrl && <a class="pill pill--accent dl" href={product.androidUrl}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={androidIcon} /></svg>{t.downloadAndroid}</a>}
      </div>
    </section>
  </main>
  <SiteFooter lang={lang} productPath={path} productName={product.name} />
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding-top: 72px;
    padding-bottom: 72px;
  }
  .ident {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }
  .ident img {
    width: 64px;
    height: 64px;
  }
  .name {
    margin: 0;
    font-size: 24px;
  }
  .platforms {
    margin: 4px 0 0;
    font-size: 12px;
    color: var(--ink-3);
  }
  h1 {
    margin: 0;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 1;
    white-space: pre-line;
  }
  .sub {
    margin: 24px 0 0;
    max-width: 560px;
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .hero-art {
    aspect-ratio: 1;
    border-radius: 40px;
    background: var(--tint);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .big {
    width: 56%;
    height: auto;
    transform: rotate(-6deg);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.28);
  }
  .block {
    padding-top: 72px;
    padding-bottom: 72px;
    border-top: 1px solid var(--line);
  }
  .block > h2,
  .demo-text h2 {
    margin: 0;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.05;
  }
  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 40px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .feature {
    background: var(--bg);
    padding: 28px;
  }
  .num {
    font-size: 13px;
    color: var(--accent);
  }
  .feature h3 {
    margin: 12px 0 10px;
    font-size: 20px;
  }
  .feature p {
    margin: 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--ink-2);
  }
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 64px;
    align-items: center;
  }
  .steps {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: s;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .steps li {
    counter-increment: s;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 17px;
    font-weight: 600;
  }
  .steps li::before {
    content: counter(s);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
    flex-shrink: 0;
  }
  .hint {
    margin: 28px 0 0;
    font-size: 13px;
    color: var(--ink-3);
  }
  .download {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 32px;
  }
  .download img {
    width: 96px;
    height: 96px;
  }
  .download > div {
    flex: 1 1 280px;
  }
  .download h2 {
    margin: 0;
    font-size: 40px;
  }
  .download .sub {
    margin-top: 6px;
  }
  .dl {
    gap: 8px;
  }
  .dl svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
    flex-shrink: 0;
  }
  .download-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 960px) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .hero,
    .demo {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-art {
      max-width: 360px;
    }
    .demo {
      justify-items: center;
    }
    .features {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

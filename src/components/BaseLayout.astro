---
import '../styles.css';
import { ui, localize } from '../i18n.js';

interface Props {
  lang: 'zh' | 'en';
  title: string;
  description?: string;
  icon?: string;
  // 当前页面不带语言前缀的路径，用来生成另一种语言的链接
  path?: string;
}

const { lang, title, description = '', icon, path = '/' } = Astro.props;
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const canonical = `${site}${localize(lang, path)}`;
const ogImage = icon ? `${site}${icon}` : undefined;
---

<!doctype html>
<html lang={ui[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    {icon && <link rel="icon" href={icon} />}
    {icon && <link rel="apple-touch-icon" href={icon} />}
    <link rel="alternate" hreflang="zh" href={`${site}${localize('zh', path)}`} />
    <link rel="alternate" hreflang="en" href={`${site}${localize('en', path)}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${localize('zh', path)}`} />
    {
      lang === 'zh' && (
        <script is:inline define:vars={{ enPath: localize('en', path) }}>
          // 中文页：浏览器不是中文、且用户没手动选过语言时，跳到英文版。
          // 搜索引擎爬虫不跳，否则中文页会因为爬虫是英文环境而收录不到。
          try {
            var pref = localStorage.getItem('someget-lang');
            var nav = (navigator.languages && navigator.languages[0]) || navigator.language || '';
            var bot = navigator.webdriver || /bot|crawl|spider|slurp|preview/i.test(navigator.userAgent);
            if (!pref && !bot && !/^zh/i.test(nav)) location.replace(enPath);
          } catch (e) {}
        </script>
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@700&family=Noto+Sans+SC:wght@400;500;700;900&family=JetBrains+Mono:wght@600&display=swap"
    />
    <!-- Vercel Web Analytics 和 Speed Insights（需要在 Vercel 项目里开启才生效） -->
    <script is:inline>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
      window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
    </script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
  </body>
</html>

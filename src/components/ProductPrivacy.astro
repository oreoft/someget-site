---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { getProduct } from '../products.js';
import { ui, localize } from '../i18n.js';
import loopback from '../content/loopback.js';
import muninn from '../content/muninn.js';
import instash from '../content/instash.js';

interface Props {
  id: string;
  lang: 'zh' | 'en';
}

const contents: Record<string, any> = { loopback, muninn, instash };
const { id, lang } = Astro.props;
const product = getProduct(id);
const policy = contents[id][lang].privacy;
const t = ui[lang];
---

<BaseLayout lang={lang} title={`${product.name} · ${t.privacy}`} icon={`/icons/${id}.png`} path={`/${id}/privacy`}>
  <SiteHeader lang={lang} path={`/${id}/privacy`} />
  <main class="container doc">
    <a class="mono kicker" href={localize(lang, `/${id}`)}>← {product.name}</a>
    <h1 class="display">{t.privacy}</h1>
    <p class="mono updated">{t.updated}: {policy.updated}</p>
    <p class="lead">{policy.intro}</p>
    {
      policy.sections.map((s: { h: string; p: string[] }) => (
        <section>
          <h2>{s.h}</h2>
          {s.p.map((para) => (
            <p>{para}</p>
          ))}
        </section>
      ))
    }
  </main>
  <SiteFooter lang={lang} productPath={`/${id}`} />
</BaseLayout>

<style>
  .doc {
    max-width: 760px;
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .kicker {
    display: inline-block;
    margin: 0 0 12px;
    text-decoration: none;
    font-size: 13px;
    color: var(--ink-3);
  }
  h1 {
    margin: 0;
    font-size: clamp(40px, 6vw, 64px);
  }
  .updated {
    margin: 16px 0 0;
    font-size: 13px;
    color: var(--ink-3);
  }
  .lead {
    margin: 32px 0 8px;
    font-size: 18px;
    line-height: 1.8;
  }
  h2 {
    margin: 40px 0 8px;
    font-size: 20px;
  }
  section p {
    margin: 8px 0 0;
    font-size: 16px;
    line-height: 1.8;
    color: var(--ink-2);
  }
</style>

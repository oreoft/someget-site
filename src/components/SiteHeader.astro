---
import { ui, localize } from '../i18n.js';

interface Props {
  lang: 'zh' | 'en';
  // 当前页面不带语言前缀的路径，用来生成切换语言的链接
  path?: string;
  // 在产品页里传产品路径（如 /loopback），导航的「联系」换成该产品的「支持」
  productPath?: string;
}

const { lang, path = '/', productPath } = Astro.props;
const t = ui[lang];
const other = lang === 'zh' ? 'en' : 'zh';
const homeHref = localize(lang, '/');
---

<header>
  <div class="container bar">
    <a class="logo display" href={homeHref}>someget<span>.</span></a>
    <nav>
      <a href={`${homeHref}#products`}>{productPath ? t.allProducts : t.products}</a>
      {productPath ? <a href={localize(lang, `${productPath}/support`)}>{t.support}</a> : <a href="#contact">{t.contact}</a>}
      <a class="lang" href={localize(other, path)} hreflang={other} data-lang={other}>{t.switchLabel}</a>
    </nav>
  </div>
</header>

<script>
  // 记住用户手动选的语言，首页据此决定要不要自动跳英文
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('someget-lang', a.dataset.lang ?? '');
      } catch {}
    });
  });
</script>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    padding-bottom: 24px;
  }
  header {
    border-bottom: 2px solid var(--ink);
  }
  .logo {
    flex-shrink: 0;
    font-size: 22px;
    text-decoration: none;
  }
  .logo span {
    color: var(--accent);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 15px;
    font-weight: 600;
  }
  nav a {
    white-space: nowrap;
    text-decoration: none;
  }
  .lang {
    padding: 6px 12px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    font-size: 13px;
  }
  .lang:hover {
    background: var(--ink);
    color: var(--bg);
  }
  /* 手机上一行放下 logo + 三个入口：整体收小、间距收紧 */
  @media (max-width: 560px) {
    .bar {
      gap: 12px;
      padding-top: 16px;
      padding-bottom: 16px;
    }
    .logo {
      font-size: 19px;
    }
    nav {
      gap: 14px;
      font-size: 14px;
    }
    .lang {
      padding: 4px 10px;
      font-size: 12px;
    }
  }
  @media (max-width: 360px) {
    nav {
      gap: 10px;
      font-size: 13px;
    }
  }
</style>

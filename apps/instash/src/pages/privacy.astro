---
import BaseLayout from '@someget/ui/components/BaseLayout.astro';
import SiteHeader from '@someget/ui/components/SiteHeader.astro';
import SiteFooter from '@someget/ui/components/SiteFooter.astro';
---

<BaseLayout title="InStash · 隐私政策" icon="/icon.png">
  <SiteHeader />
  <main class="container" style="padding: 64px 24px 96px;">
    <h1 class="display" style="font-size: 56px; margin: 0 0 24px;">隐私政策</h1>
    <p style="color: var(--ink-3);">[InStash 的隐私政策内容待写]</p>
  </main>
  <SiteFooter privacy="/privacy" />
</BaseLayout>

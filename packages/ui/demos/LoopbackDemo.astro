---
// Loopback 演示：登录 Tailscale → 选设备 → 加端口书签 → 点卡片打开。
// App 本身是英文界面，演示里的界面文字照搬 App；提示语按页面语言。
interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const zh = lang === 'zh';
const tip = {
  signin: zh ? '点这里登录' : 'Tap to sign in',
  signing: zh ? '正在连接 Tailscale…' : 'Connecting to Tailscale…',
  pick: zh ? '点一台设备' : 'Tap a device',
  save: zh ? '点 Save 保存' : 'Tap Save',
  open: zh ? '点卡片打开' : 'Tap the card',
  probing: zh ? '正在探测 nas:8096…' : 'Checking nas:8096…',
  tunnel: zh ? '已通过 Tailscale 连接' : 'Connected via Tailscale',
  again: zh ? '再来一次' : 'Start over',
};
---

<div class="lb" data-demo="loopback">
  <!-- 0 Servers -->
  <div class="scr" data-screen="servers">
    <div class="nav"><span class="title">Servers</span><span class="plus">+</span></div>
    <p class="group">TAILSCALE · DIRECT</p>
    <div class="card center">
      <div class="ts-logo" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <p class="muted">Connect Tailscale</p>
      <button type="button" class="primary pulse" data-go="signing">Sign in with Tailscale</button>
      <span class="tip">{tip.signin}</span>
    </div>
    <p class="group">SERVERS · SSH TUNNEL</p>
    <div class="card row"><span class="dot gray"></span><span>dev-box</span><span class="muted sm">10.0.0.8:22</span></div>
    <div class="tabs"><span>Browser</span><span class="on">Servers</span><span>Settings</span></div>
  </div>

  <!-- 1 登录中 -->
  <div class="scr" data-screen="signing" data-auto="devices:1300" hidden>
    <div class="nav"><span class="title">Servers</span></div>
    <div class="center fill">
      <span class="spinner" aria-hidden="true"></span>
      <p class="muted">{tip.signing}</p>
    </div>
  </div>

  <!-- 2 设备列表 -->
  <div class="scr" data-screen="devices" hidden>
    <div class="nav"><span class="title">Servers</span><span class="plus">+</span></div>
    <p class="group">TAILSCALE · DIRECT</p>
    <div class="card list">
      <button type="button" class="row pulse-row" data-go="add">
        <span class="dot green"></span><span class="grow">nas</span><span class="muted sm">100.101.2.3</span>
      </button>
      <div class="row"><span class="dot green"></span><span class="grow">homelab</span><span class="muted sm">100.88.14.20</span></div>
      <div class="row"><span class="dot gray"></span><span class="grow">macbook</span><span class="muted sm">100.71.9.4</span></div>
    </div>
    <span class="tip left">{tip.pick}</span>
    <div class="tabs"><span>Browser</span><span class="on">Servers</span><span>Settings</span></div>
  </div>

  <!-- 3 新建书签 -->
  <div class="scr sheet-bg" data-screen="add" hidden>
    <div class="sheet">
      <div class="nav small"><span class="muted">Cancel</span><span class="title-sm">Add Bookmark</span><button type="button" class="link pulse-text" data-go="browser">Save</button></div>
      <p class="group">BOOKMARK INFO</p>
      <div class="card list">
        <div class="row"><span class="grow">Device</span><span class="muted">nas</span></div>
        <div class="row"><span class="grow">Name</span><span>Jellyfin</span></div>
        <div class="row"><span class="grow">Port</span><span>8096</span></div>
        <div class="row"><span class="grow">Path</span><span class="muted">/web</span></div>
      </div>
      <p class="group">COLOR</p>
      <div class="card swatches">
        <span style="background:#5b8cff" class="sel"></span><span style="background:#ff9f43"></span><span style="background:#2ecc71"></span><span style="background:#e056fd"></span><span style="background:#ff6b6b"></span>
      </div>
      <span class="tip right">{tip.save}</span>
    </div>
  </div>

  <!-- 4 Browser 首页 -->
  <div class="scr" data-screen="browser" hidden>
    <div class="nav"><span class="title">Loopback</span><span class="plus">+</span></div>
    <div class="chips"><span class="on">All</span><span>nas</span><span>homelab</span></div>
    <div class="grid">
      <button type="button" class="bm pulse" style="background:#5b8cff" data-go="probing">
        <span class="ic" aria-hidden="true">▶</span><b>Jellyfin</b><small>nas:8096</small>
      </button>
      <div class="bm" style="background:#ff9f43"><span class="ic" aria-hidden="true">⌂</span><b>Home Assistant</b><small>homelab:8123</small></div>
      <div class="bm" style="background:#2ecc71"><span class="ic" aria-hidden="true">≡</span><b>Grafana</b><small>homelab:3000</small></div>
    </div>
    <span class="tip left">{tip.open}</span>
    <div class="tabs"><span class="on">Browser</span><span>Servers</span><span>Settings</span></div>
  </div>

  <!-- 5 探测端口 -->
  <div class="scr" data-screen="probing" data-auto="web:1200" hidden>
    <div class="nav"><span class="title">Loopback</span></div>
    <div class="center fill">
      <span class="spinner" aria-hidden="true"></span>
      <p class="muted">{tip.probing}</p>
    </div>
  </div>

  <!-- 6 打开网页 -->
  <div class="scr web" data-screen="web" hidden>
    <div class="urlbar">
      <button type="button" class="link" data-go="browser" aria-label="Back">‹</button>
      <span class="url">nas:8096/web</span>
      <span class="lock" aria-hidden="true">●</span>
    </div>
    <p class="ok">{tip.tunnel}</p>
    <div class="site">
      <p class="site-title">Jellyfin</p>
      <p class="site-h">Continue Watching</p>
      <div class="posters"><i style="background:#3b4a6b"></i><i style="background:#6b3b4a"></i><i style="background:#3b6b5a"></i></div>
      <p class="site-h">Movies</p>
      <div class="posters"><i style="background:#56406b"></i><i style="background:#6b5a3b"></i><i style="background:#3b5f6b"></i></div>
    </div>
    <button type="button" class="again" data-go="servers">{tip.again}</button>
  </div>
</div>

<script>
  import { initDemos } from './runtime';
  initDemos();
</script>

<style>

  }
  .primary {
    background: #007aff;
    color: #fff;
    border-radius: 10px;
    padding: 10px 16px;
    font-weight: 600;
    text-align: center;
  }
  .link {
    color: #007aff;
    font-weight: 600;
  }
  .ts-logo {
    display: grid;
    grid-template-columns: repeat(3, 8px);

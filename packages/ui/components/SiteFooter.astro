---
import { contactEmail } from '../products.js';

interface Props {
  privacy?: string;
}

const { privacy } = Astro.props;
const year = new Date().getFullYear();
---

<footer id="contact" class="container">
  <div class="foot">
    <span class="logo display">someget<span>.</span></span>
    <div class="links">
      <span>© {year}</span>
      <a href={`mailto:${contactEmail}`}>联系</a>
      {privacy && <a href={privacy}>隐私政策</a>}
    </div>
  </div>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: baseline;
    padding: 48px 0 56px;
  }
  .logo {
    font-size: 40px;
  }
  .logo span {
    color: var(--accent);
  }
  .links {
    display: flex;
    gap: 24px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .links a {
    text-decoration: none;
  }
</style>

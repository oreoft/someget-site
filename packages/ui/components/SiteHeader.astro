---
import { ui, localize } from '../i18n.js';

interface Props {
  lang: 'zh' | 'en';
  path?: string;
  // 官网首页地址；官网自己传空字符串，链接就留在站内
  home?: string;
}

const { lang, path = '/', home = 'https://someget.xyz' } = Astro.props;
const t = ui[lang];
const other = lang === 'zh' ? 'en' : 'zh';
const homeHref = `${home}${localize(lang, '/')}`;
---

<header class="container">
  <div class="bar">
    <a class="logo display" href={homeHref}>someget<span>.</span></a>
    <nav>
      <a href={`${homeHref}#products`}>{t.products}</a>
      <a href="#contact">{t.contact}</a>
      <a class="lang" href={localize(other, path)} hreflang={other} data-lang={other}>{t.switchLabel}</a>
    </nav>
  </div>
</header>

<script>
  // 记住用户手动选的语言，首页据此决定要不要自动跳英文
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('someget-lang', a.dataset.lang ?? '');
      } catch {}
    });
  });
</script>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 28px 0;
    border-bottom: 2px solid var(--ink);
  }
  .logo {
    font-size: 22px;
    text-decoration: none;
  }
  .logo span {
    color: var(--accent);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 15px;
    font-weight: 600;
  }
  nav a {
    text-decoration: none;
  }
  .lang {
    padding: 6px 12px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    font-size: 13px;
  }
  .lang:hover {
    background: var(--ink);
    color: var(--bg);
  }
</style>
